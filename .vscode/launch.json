{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "تشغيل السيرفر محليًا",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8100",
