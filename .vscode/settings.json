{
  "python.analysis.extraPaths": [
    "./.packages"
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "tests",
    "-q"
  ],
  "files.exclude": {
    "**/__pycache__": true,
    ".packages": true
  },
  "search.exclude": {
    ".packages": true
  },
  "terminal.integrated.env.windows": {
    "PYTHONPATH": "${workspaceFolder}\\.packages",
    "WHOLESALE_OWNER_USERNAME": "owner",
    "WHOLESALE_OWNER_DISPLAY_NAME": "Owner",
    "WHOLESALE_OWNER_PASSWORD": "Local-owner-123"
  }
}
